# Canonical origin, no trailing slash. Drives canonical tags, Open Graph URLs,
# sitemap.xml and robots.txt. Optional when building — it defaults to
# https://kangkan.in, so a hand-built out/ never advertises localhost.
# NEXT_PUBLIC_SITE_URL=https://kangkan.in

# Only set this when the site is served from a subdirectory rather than a domain
# root. Leave empty for GitHub Pages on kangkan.in.
# NEXT_PUBLIC_BASE_PATH=

# Web3Forms access key — https://web3forms.com. Free, no backend required.
# Create it with the inbox address that should receive enquiries, then add the
# same value as the repository secret WEB3FORMS_KEY so GitHub Actions bakes it
# into the build. Without a key the contact form opens a prefilled email draft.
NEXT_PUBLIC_WEB3FORMS_KEY=
